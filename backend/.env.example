DATABASE_URL="postgresql://washaway:washaway@localhost:5433/washaway"
TEST_DATABASE_URL="postgresql://washaway:washaway@localhost:5433/washaway_test"
PORT=4000

# Worker de e-mail (scripts/email_worker.py) — ver "E-mail (outbox + worker)" na backend.specs.md
# arquivo (dev: grava em .emails/) | smtp (produção)
EMAIL_TRANSPORTE=arquivo
# EMAIL_PASTA=.emails
# EMAIL_MAX_TENTATIVAS=5
# EMAIL_ESPERA_BASE_SEGUNDOS=30
# EMAIL_VARREDURA_SEGUNDOS=30
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="WashAway <nao-responda@washaway.com>"

# Token de acesso (JWT HS256) — ver "Autenticação" na backend.specs.md.
# Obrigatório (mínimo 32 caracteres): o servidor não sobe sem ele. Gere um valor aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Validade do token (formato do jsonwebtoken: 7d, 12h, 3600…). Padrão: 7d.
JWT_EXPIRES_IN=7d
