generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LavaRapido {
  id           String   @id @default(cuid())
  name         String
  address      String?
  cnpj         String   @unique
  senha        String
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  distance     String
  time         String
  price        Float
  isOpen       Boolean  @default(true)
  image        String
  latitude     Float
  longitude    Float
  pedidos      Pedido[]
  servicos     Servico[]
  intercorrencias Intercorrencia[]
}

enum PedidoStatus {
  pendente
  em_andamento
  concluido
}

model Pedido {
  id           String       @id @default(cuid())
  lavaRapidoId String
  lavaRapido   LavaRapido   @relation(fields: [lavaRapidoId], references: [id], onDelete: Cascade)
  veiculo      Json
  servico      String
  horario      DateTime
  status       PedidoStatus @default(pendente)
  fotos        String[]     @default([])
}

model Servico {
  id           String     @id @default(cuid())
  lavaRapidoId String
  lavaRapido   LavaRapido @relation(fields: [lavaRapidoId], references: [id], onDelete: Cascade)
  nome         String
  categoria    String
  preco        Float
  ativo        Boolean    @default(true)
}

// `data` é String (não DateTime): o admin-front (Disponibilidade.jsx) casa esse
// campo por igualdade exata no formato "YYYY-MM-DD" pra marcar dias no
// calendário — um DateTime serializaria como ISO completo e quebraria esse match.
model Intercorrencia {
  id           String     @id @default(cuid())
  lavaRapidoId String
  lavaRapido   LavaRapido @relation(fields: [lavaRapidoId], references: [id], onDelete: Cascade)
  data         String
  motivo       String
  diaInteiro   Boolean    @default(true)
  horaInicio   String?
  horaFim      String?
  reaberta     Boolean    @default(false)
}
