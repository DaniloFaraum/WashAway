generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LavaRapido {
  id           String   @id @default(cuid())
  name         String
  address      String?
  cnpj         String   @unique
  // E-mail de acesso (I17): normalizado (trim + minúsculas), único. Opcional só
  // por causa das empresas criadas antes do I17; o onboarding sempre preenche.
  email        String?  @unique
  senha        String
  // Senha temporária enviada por e-mail (i17-senha-gerada), hash bcrypt. Quando
  // existe, entrar com ela leva à troca obrigatória; entrar com a `senha` a zera.
  senhaGerada  String?
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  distance     String
  time         String
  price        Float
  isOpen       Boolean  @default(true)
  image        String
  latitude     Float
  longitude    Float
  pedidos      Pedido[]
  servicos     Servico[]
  intercorrencias Intercorrencia[]
  horarios     HorarioFuncionamento[]
  solicitacoesExclusao SolicitacaoExclusao[]
}

// Fluxo (I15): pendente → aceito | recusado; aceito → em_andamento → concluido.
// A regra fica em src/modules/pedidos/pedidoStatus.ts.
enum PedidoStatus {
  pendente
  aceito
  recusado
  em_andamento
  concluido
}

// Pedido (I13): criado pelo cliente do app (`POST /pedidos`). Cliente e veículo
// são do cadastro (I1/I3); os serviços comprados ficam em `PedidoServico` com
// nome/preço/duração congelados, e `precoTotal`/`duracaoMinutos` são calculados
// no servidor. Cliente/veículo com pedido não podem ser apagados (Restrict):
// o histórico do lava-rápido não some. Os pedidos anteriores ao I13 (veículo em
// JSON + serviço em texto) foram convertidos pela migration
// `20261017120000_pedido_cliente_servicos`.
model Pedido {
  id             String          @id @default(cuid())
  lavaRapidoId   String
  lavaRapido     LavaRapido      @relation(fields: [lavaRapidoId], references: [id], onDelete: Cascade)
  clienteId      String
  cliente        Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  veiculoId      String
  veiculo        Veiculo         @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  horario        DateTime
  status         PedidoStatus    @default(pendente)
  fotos          String[]        @default([])
  precoTotal     Float
  duracaoMinutos Int
  criadoEm       DateTime        @default(now())
  // I15: data da última mudança de status (null = nunca mudou) e motivo da
  // recusa (opcional, até 200 caracteres, só em `recusado`).
  statusAlteradoEm DateTime?
  motivoRecusa     String?
  servicos       PedidoServico[]

  @@index([lavaRapidoId, horario])
  @@index([clienteId])
}

// Serviço comprado num pedido (I13): snapshot do `Servico` no momento da compra —
// mudar o preço/nome do serviço depois não altera pedidos já feitos.
model PedidoServico {
  id             String   @id @default(cuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // Referência informativa; vira null se o serviço for apagado.
  servicoId      String?
  servico        Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  nome           String
  preco          Float
  duracaoMinutos Int
  ordem          Int      @default(0)

  @@index([pedidoId])
}

model Servico {
  id           String     @id @default(cuid())
  lavaRapidoId String
  lavaRapido   LavaRapido @relation(fields: [lavaRapidoId], references: [id], onDelete: Cascade)
  nome         String
  preco        Float
  ativo        Boolean    @default(true)
  itens        ServicoItem[]
  pedidoServicos PedidoServico[]
}

// Catálogo global de itens (serviços "atômicos" de lava-rápido), mantido só via
// seed/banco — a loja não cria itens, só monta seus `Servico`s (combos) com eles.
model ItemServico {
  id        String        @id @default(cuid())
  nome      String        @unique
  descricao String
  categoria String
  // Duração estimada em minutos; a duração de um combo (Servico) é a soma dos
  // seus itens, derivada na resposta da API (sem coluna própria).
  duracaoMinutos Int
  ativo     Boolean       @default(true)
  servicos  ServicoItem[]
}

model ServicoItem {
  servicoId String
  servico   Servico     @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  itemId    String
  item      ItemServico @relation(fields: [itemId], references: [id])

  @@id([servicoId, itemId])
}

// `data` é String (não DateTime): o admin-front (Disponibilidade.jsx) casa esse
// campo por igualdade exata no formato "YYYY-MM-DD" pra marcar dias no
// calendário — um DateTime serializaria como ISO completo e quebraria esse match.
model Intercorrencia {
  id           String     @id @default(cuid())
  lavaRapidoId String
  lavaRapido   LavaRapido @relation(fields: [lavaRapidoId], references: [id], onDelete: Cascade)
  data         String
  motivo       String
  diaInteiro   Boolean    @default(true)
  horaInicio   String?
  horaFim      String?
  reaberta     Boolean    @default(false)
}

// Cliente do app (I1). `email` é salvo normalizado (trim + minúsculas), então o
// @unique já garante unicidade sem diferenciar maiúsculas. `senha` = hash bcrypt.
model Cliente {
  id       String   @id @default(cuid())
  nome     String
  email    String   @unique
  senha    String
  criadoEm DateTime @default(now())
  veiculos Veiculo[]
  pedidos  Pedido[]
}

// Veículo do cliente do app (I3). Placa gravada normalizada (sem hífen/espaços,
// maiúsculas — src/modules/veiculos-cliente/placa.ts) e única por cliente; a
// mesma placa pode existir em clientes diferentes. O `GET /veiculos` do painel
// lista os veículos dos pedidos da empresa (relação `Pedido.veiculo`, I13).
model Veiculo {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  marca     String?
  modelo    String
  cor       String
  placa     String
  criadoEm  DateTime @default(now())
  pedidos   Pedido[]

  @@unique([clienteId, placa])
}

// Horário semanal (I19): um intervalo por dia, hora local (FUSO_LAVA_RAPIDOS,
// src/utils/fusoHorario.ts). Lava-rápido sem horário cadastrado para o dia =
// sem restrição de horário (só as intercorrências fecham).
model HorarioFuncionamento {
  id           String     @id @default(cuid())
  lavaRapidoId String
  lavaRapido   LavaRapido @relation(fields: [lavaRapidoId], references: [id], onDelete: Cascade)
  diaSemana    Int        // 0 = domingo … 6 = sábado
  fechado      Boolean    @default(false)
  abertura     String?    // "HH:mm" hora local; null quando fechado
  fechamento   String?    // "HH:mm" hora local; null quando fechado

  @@unique([lavaRapidoId, diaSemana])
}

// Repositório de contratos do onboarding — versionado, um vigente por vez.
// Trocar o texto = inserir nova versão via banco/seed (sem UI nesta task).
model Contrato {
  id           String                  @id @default(cuid())
  versao       Int                     @unique
  titulo       String
  conteudo     String
  vigente      Boolean                 @default(false)
  criadoEm     DateTime                @default(now())
  solicitacoes SolicitacaoOnboarding[]
}

enum SolicitacaoStatus {
  aguardando_contrato
  concluida
}

// Separada de LavaRapido de propósito: só vira LavaRapido quem aceitou o
// contrato, então nenhum endpoint da aplicação precisa filtrar pendentes.
model SolicitacaoOnboarding {
  id           String            @id @default(cuid())
  name         String
  address      String?
  cnpj         String
  // I17: e-mail e senha própria informados na solicitação (senha já com hash
  // bcrypt). Opcionais só por causa das solicitações anteriores ao I17.
  email        String?
  senhaHash    String?
  status       SolicitacaoStatus @default(aguardando_contrato)
  contratoId   String
  contrato     Contrato          @relation(fields: [contratoId], references: [id])
  aceitoEm     DateTime?
  lavaRapidoId String?           @unique
  criadoEm     DateTime          @default(now())
}

// Outbox de e-mails (I17): gravado na mesma transação da ação que gera o
// e-mail; o worker Python (scripts/email_worker.py) envia e marca o status.
// Ver "E-mail (outbox + worker)" em .specs/backend.specs.md.
enum StatusEventoEmail {
  pendente
  enviado
  erro
}

// Cada plano consumidor acrescenta os seus valores (sem reescrever os dos outros).
enum TipoEventoEmail {
  teste
  // i17-interno-exclusao
  exclusao_solicitada
  exclusao_aprovada
  exclusao_recusada
  // i17-senha-gerada
  senha_gerada
  esqueci_senha
}

model EventoEmail {
  id           String            @id @default(cuid())
  tipo         TipoEventoEmail
  destinatario String
  assunto      String
  // Pode conter senha gerada: o worker troca por "[enviado — conteúdo removido]"
  // depois do envio, e nunca o escreve em log.
  corpo        String
  status       StatusEventoEmail @default(pendente)
  tentativas   Int               @default(0)
  ultimoErro   String?
  // Quando o worker pode tentar de novo um evento em `erro` (espera crescente).
  proximaTentativaEm DateTime?
  criadoEm     DateTime          @default(now())
  enviadoEm    DateTime?

  @@index([status, criadoEm])
}

// Equipe WashAway (i17-interno-exclusao). Criado só por script/seed/demo
// (`npm run interno:criar`), nunca por rota. `email` normalizado (trim +
// minúsculas); `senha` = hash bcrypt. Permissões (ex.: `admin`) vão no token
// e são conferidas por `autorizar(...)`.
model UsuarioInterno {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  senha      String
  permissoes String[] @default([])
  criadoEm   DateTime @default(now())
  decisoesExclusao SolicitacaoExclusao[]
}

enum StatusSolicitacaoExclusao {
  pendente
  aprovada
  recusada
  cancelada
}

// Pedido de exclusão da empresa (i17-interno-exclusao): a empresa solicita, um
// interno `admin` aprova (exclui o LavaRapido) ou recusa. `nome`/`cnpj`/`email`
// são snapshot, para o registro sobreviver à exclusão (`lavaRapidoId` vira null).
model SolicitacaoExclusao {
  id            String                    @id @default(cuid())
  lavaRapidoId  String?
  lavaRapido    LavaRapido?               @relation(fields: [lavaRapidoId], references: [id], onDelete: SetNull)
  nome          String
  cnpj          String
  email         String?
  motivo        String?
  status        StatusSolicitacaoExclusao @default(pendente)
  criadoEm      DateTime                  @default(now())
  decididoEm    DateTime?
  decididoPorId String?
  decididoPor   UsuarioInterno?           @relation(fields: [decididoPorId], references: [id], onDelete: SetNull)
  observacao    String?

  @@index([lavaRapidoId, status])
  @@index([status, criadoEm])
}
